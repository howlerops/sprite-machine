{
  "name": "@sprite-machine/mobile",
  "private": true,
  "version": "0.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "web": "expo start --web --port 19006",
    "export:web": "expo export --platform web --output-dir dist-web",
    "export:ios": "expo export --platform ios --output-dir dist-ios",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@babel/runtime": "^7.20.0",
    "@expo/metro-config": "~0.20.18",
    "@expo/metro-runtime": "~4.0.1",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@shopify/flash-list": "1.7.5",
    "@sprite-machine/shared": "workspace:*",
    "@tanstack/react-query": "^5.100.9",
    "expo": "~53.0.27",
    "expo-constants": "~17.1.8",
    "expo-linking": "~7.0.5",
    "expo-notifications": "~0.29.14",
    "expo-router": "~4.0.22",
    "expo-secure-store": "~55.0.13",
    "expo-status-bar": "~2.2.3",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.5",
    "react-native-reanimated": "~3.19.5",
    "react-native-safe-area-context": "~4.14.1",
    "react-native-screens": "~3.37.0",
    "react-native-sse": "^1.2.1",
    "react-native-web": "~0.20.0"
  },
  "devDependencies": {
    "@types/react": "~19.0.0",
    "typescript": "^5.7.3"
  }
}
