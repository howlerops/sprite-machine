# Copy to .env and fill in. The control plane and CLI scripts read from process.env.

# --- Control plane ---
# Bearer token clients (mobile app, web) must send: Authorization: Bearer $USER_TOKEN
USER_TOKEN=replace-with-a-long-random-string
# Shared secret between sidecars (inside sprites) and the control plane webhook
CONTROL_PLANE_WEBHOOK_TOKEN=replace-with-another-long-random-string
# Public URL the sprite-agents use to reach the control plane. Defaults to http://HOST:PORT.
# Set this to your Fly app's public URL once deployed.
# PUBLIC_BASE_URL=https://sprite-machine.fly.dev

# Bind address. Default 127.0.0.1:8787; bind 0.0.0.0 in production.
# HOST=0.0.0.0
# PORT=8787

# Idle/wake tuning
# IDLE_SUSPEND_AFTER_MS=300000     # 5 minutes
# IDLE_CHECK_INTERVAL_MS=30000     # 30 seconds

# --- Sprites backend ---
# 'local' for dev (child processes), 'fly' for sprites.dev (production, M1 stub)
# SPRITES_BACKEND=local
# SPRITES_API_TOKEN=                # required when SPRITES_BACKEND=fly

# --- Sprite-side agent (Anthropic auth) ---
# Optional. If set, sidecars run via the Claude Agent SDK; otherwise MockAgent.
# ANTHROPIC_API_KEY=

# Override what the control plane points sidecars at. Auto-set from PUBLIC_BASE_URL otherwise.
# CONTROL_PLANE_WEBHOOK_URL=

# Force sidecar mode: 'auto' | 'sdk' | 'mock'
# SPRITE_AGENT_MODE=auto

# --- Push notifications ---
# Optional. Used to authenticate against Expo Push Service for higher rate limits.
# EXPO_ACCESS_TOKEN=

# --- Template checkpoint ---
# After running `pnpm build-template`, the checkpoint id is written to
# .sprite-machine-data/template.json and auto-loaded. Set this only to override.
# TEMPLATE_CHECKPOINT_ID=
