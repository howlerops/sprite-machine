{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sprite-machine.dev/schemas/turn-event/v1/events/StepStarted.schema.json",
  "title": "StepStarted",
  "description": "A flow step began.",
  "x-scope": "run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "step_id",
    "step_name"
  ],
  "properties": {
    "type": {
      "const": "StepStarted"
    },
    "step_id": {
      "$ref": "../common.schema.json#/$defs/Id"
    },
    "step_name": {
      "type": "string"
    },
    "iteration": {
      "type": "integer",
      "minimum": 0
    }
  }
}
