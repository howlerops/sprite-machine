{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sprite-machine.dev/schemas/turn-event/v1/envelope.schema.json",
  "title": "TurnEvent envelope",
  "description": "See docs/specs/turn-event.md. seq is assigned by the Thread DO (0 = not yet assigned, producer side only).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "seq",
    "thread_id",
    "task_id",
    "run_id",
    "ts",
    "event"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "seq": {
      "type": "integer",
      "minimum": 0
    },
    "thread_id": {
      "$ref": "common.schema.json#/$defs/Id"
    },
    "task_id": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/Id"
        },
        {
          "type": "null"
        }
      ]
    },
    "run_id": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/Id"
        },
        {
          "type": "null"
        }
      ]
    },
    "ts": {
      "$ref": "common.schema.json#/$defs/Timestamp"
    },
    "event": {
      "oneOf": [
        {
          "$ref": "events/UserMessage.schema.json"
        },
        {
          "$ref": "events/RunStarted.schema.json"
        },
        {
          "$ref": "events/RunFinished.schema.json"
        },
        {
          "$ref": "events/RunError.schema.json"
        },
        {
          "$ref": "events/TextMessageStart.schema.json"
        },
        {
          "$ref": "events/TextMessageContent.schema.json"
        },
        {
          "$ref": "events/TextMessageEnd.schema.json"
        },
        {
          "$ref": "events/ReasoningMessageStart.schema.json"
        },
        {
          "$ref": "events/ReasoningMessageContent.schema.json"
        },
        {
          "$ref": "events/ReasoningMessageEnd.schema.json"
        },
        {
          "$ref": "events/ToolCallStart.schema.json"
        },
        {
          "$ref": "events/ToolCallArgs.schema.json"
        },
        {
          "$ref": "events/ToolCallEnd.schema.json"
        },
        {
          "$ref": "events/ToolCallResult.schema.json"
        },
        {
          "$ref": "events/Activity.schema.json"
        },
        {
          "$ref": "events/Interrupt.schema.json"
        },
        {
          "$ref": "events/InterruptResolved.schema.json"
        },
        {
          "$ref": "events/StateSnapshot.schema.json"
        },
        {
          "$ref": "events/StateDelta.schema.json"
        },
        {
          "$ref": "events/SubagentStarted.schema.json"
        },
        {
          "$ref": "events/SubagentFinished.schema.json"
        },
        {
          "$ref": "events/SubagentError.schema.json"
        },
        {
          "$ref": "events/StepStarted.schema.json"
        },
        {
          "$ref": "events/StepFinished.schema.json"
        },
        {
          "$ref": "events/Checkpoint.schema.json"
        },
        {
          "$ref": "events/Presence.schema.json"
        },
        {
          "$ref": "events/Raw.schema.json"
        }
      ]
    },
    "raw": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "payload"
      ],
      "properties": {
        "source": {
          "enum": [
            "acp",
            "a2a",
            "agui",
            "flow",
            "hub"
          ]
        },
        "payload": {}
      }
    }
  }
}
