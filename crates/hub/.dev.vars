# Local `wrangler dev` secrets/vars (never deployed: `wrangler deploy` ignores this file).
# DEV_FIXTURES=1 turns on the dev-only hub routes and the placeholder `Bearer dev` token
# (docs/specs/client-api.md §2). `bash scripts/hub-test.sh <test>` runs wrangler without
# `--env dev`, so the `[env.dev.vars]` table in wrangler.toml does not apply there.
DEV_FIXTURES=1
