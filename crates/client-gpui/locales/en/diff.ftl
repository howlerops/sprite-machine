# Diff viewer strings (en). Referenced from src/diff/ and checked by tests/diff.rs.

diff-region-a11y = Changes to { $path }
diff-summary = { $path }: { $added } added, { $removed } removed
diff-new-file = New file
diff-mode-unified = Unified
diff-mode-split = Split
diff-mode-unified-a11y = Show the changes in one column
diff-mode-split-a11y = Show the old and new text side by side
diff-expand-all = Expand all
diff-gap = Show { $count } unchanged lines
diff-gap-one = Show 1 unchanged line
diff-open = Open file
diff-open-a11y = Open { $path } at line { $line }
diff-no-newline = No newline at end of file
diff-binary = Binary file: the contents are not shown.
diff-too-large = Too large to compare ({ $size }; the limit is { $limit }).
diff-identical = No changes: the old and new text are the same.
diff-hunk-a11y = Changes at line { $line }
diff-line-added = Added line { $line }: { $text }
diff-line-removed = Removed line { $line }: { $text }
diff-line-context = Line { $line }: { $text }
diff-split-a11y = Old line { $old }: { $oldtext }. New line { $new }: { $newtext }.
diff-split-empty = (none)
